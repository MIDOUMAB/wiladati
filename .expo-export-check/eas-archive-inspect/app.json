{
  "expo": {
    "name": "wiladati",
    "slug": "wiladati",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/wiladati-app-icon.png",
    "scheme": "wiladati",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/wiladati-app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F1EAFE",
        "foregroundImage": "./assets/images/wiladati-icon-foreground.png",
        "backgroundImage": "./assets/images/wiladati-icon-background.png",
        "monochromeImage": "./assets/images/wiladati-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.benzinama.wiladati"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F7F1FA",
          "image": "./assets/images/wiladati-splash.png",
          "imageWidth": 300,
          "android": {
            "backgroundColor": "#F7F1FA",
            "image": "./assets/images/wiladati-splash.png",
            "imageWidth": 300
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/PlusJakartaSans-Regular.ttf",
            "./assets/fonts/PlusJakartaSans-Bold.ttf",
            "./assets/fonts/PlusJakartaSans-Medium.ttf",
            "./assets/fonts/PlusJakartaSans-SemiBold.ttf",
            "./assets/fonts/PlusJakartaSans-ExtraBold.ttf",
            "./assets/fonts/PlusJakartaSans-Light.ttf"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      "@clerk/expo",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "fr",
              "ar"
            ],
            "android": [
              "fr",
              "ar"
            ]
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "797afae2-feab-4f2c-9c27-fea293aa6af6"
      }
    },
    "owner": "benzinama"
  }
}
